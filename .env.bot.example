# Telegram bot credentials — copy to .env.bot and fill in.
# Get token from @BotFather in Telegram.
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Comma-separated list of allowed chat_ids. Empty = allow all.
# Example: TG_ADMIN_ID=123456789,987654321
TG_ADMIN_ID=YOUR_CHAT_ID_HERE

# OmniRoute gateway (localhost)
OMNI_KEY=YOUR_OMNIROUTE_KEY
OMNIROUTE_API_KEY=YOUR_OMNIROUTE_KEY

# External APIs
FOOTBALL_DATA_KEY=YOUR_FOOTBALL_DATA_KEY
